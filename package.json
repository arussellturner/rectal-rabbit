{
  "name": "rectal-rabbit",
  "version": "0.1.0",
  "private": true,
  "description": "A side-scrolling rabbit stealth/escape game. Eat grass, poop at predators, get home.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "bash tools/deploy-branch.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arussellturner/rectal-rabbit.git"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "lil-gui": "^0.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
